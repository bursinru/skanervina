{
  "name": "svoe-vino-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "organizer": "node scripts/organizer.mjs",
    "organizer:setup": "node scripts/organizer.mjs setup",
    "organizer:start": "node scripts/organizer.mjs start",
    "organizer:stop": "node scripts/organizer.mjs stop",
    "organizer:status": "node scripts/organizer.mjs status",
    "organizer:logs": "node scripts/organizer.mjs logs",
    "backend": "backend/.venv-cv/bin/python -m uvicorn app.main:app --app-dir backend --env-file backend/.env.local --host 127.0.0.1 --port 8080",
    "web": "npm --prefix gateway run dev",
    "build:server": "npm --prefix gateway run build",
    "test:backend": "PYTHONPATH=backend backend/.venv-cv/bin/python -m unittest discover -s backend/tests"
  },
  "engines": {
    "node": ">=20"
  }
}
