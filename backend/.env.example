# PostgreSQL is required for SigLIP 2 + pgvector. Create DB and import catalog first.
DATABASE_URL=postgresql://scanner:change-me@127.0.0.1:5432/scanner
CATALOG_CSV=../Датасет/strapi_output0709_enriched.csv
IMAGE_BASE_URL=https://api.vino-svoe.ru/v1/img/str-api/800/800/resize/uploads/
CV_ENABLED=true
CV_OCR_ENABLED=false
CV_DEVICE=cpu
CV_THREADS=4
CV_MATCH_THRESHOLD=0.80
CV_MATCH_MARGIN=0.04
HF_HOME=./data/models
OCR_LANGUAGES=rus+eng
MAX_IMAGE_BYTES=15728640
# true behind HTTPS; false for localhost HTTP
COOKIE_SECURE=false
# Only used for separate-origin OCR clients. Profiles use same-origin cookies.
CORS_ORIGINS=http://localhost:4173
# Optional lightweight fallback only when DATABASE_URL is unset:
DATABASE_PATH=./data/scanner.sqlite3

# Optional: protects per-request similarity and timings in /scanner?admin=1
SCANNER_ADMIN_TOKEN=
